#!/usr/bin/env bash
# pre-commit - Enforce code quality before commits
# Runs linting, prevents direct commits to main, checks for secrets

set -e

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

print_error() { echo -e "${RED}✗ $1${NC}" >&2; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }

# Prevent commits directly to main/master branch
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
PROTECTED_BRANCHES="^(main|master)$"

if [[ "$CURRENT_BRANCH" =~ $PROTECTED_BRANCHES ]]; then
    print_error "Direct commits to '${CURRENT_BRANCH}' branch are not allowed"
    echo "Create a feature branch instead:"
    echo "  git checkout -b feature/your-feature-name"
    exit 1
fi

# Check for common secrets patterns
SECRETS_PATTERNS=(
    "password\s*=\s*['\"]([^'\"]+)"
    "api[_-]?key\s*=\s*['\"]([^'\"]+)"
    "secret\s*=\s*['\"]([^'\"]+)"
    "token\s*=\s*['\"]([^'\"]+)"
    "AWS_ACCESS_KEY"
    "PRIVATE[_-]KEY"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for file in $STAGED_FILES; do
    if [[ -f "$file" ]]; then
        for pattern in "${SECRETS_PATTERNS[@]}"; do
            if grep -iE "$pattern" "$file" | grep -v "changeme" | grep -v "your-" | grep -v "example" >/dev/null; then
                print_error "Potential secret detected in ${file}"
                echo "Pattern: ${pattern}"
                echo "Please remove secrets before committing"
                exit 1
            fi
        done
    fi
done

# Lint Python files
PYTHON_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || true)

if [[ -n "$PYTHON_FILES" ]]; then
    echo "Linting Python files..."
    
    # Check if flake8 is available
    if command -v flake8 >/dev/null 2>&1; then
        if ! echo "$PYTHON_FILES" | xargs flake8 --max-line-length=100 --extend-ignore=E203,W503; then
            print_error "Python linting failed"
            echo "Fix issues or run: git commit --no-verify (not recommended)"
            exit 1
        fi
        print_success "Python linting passed"
    else
        print_warning "flake8 not found, skipping Python linting"
    fi
fi

# Lint Shell scripts
SHELL_FILES=$(echo "$STAGED_FILES" | grep '\.sh$' || true)

if [[ -n "$SHELL_FILES" ]]; then
    echo "Checking shell scripts..."
    
    # Check if shellcheck is available
    if command -v shellcheck >/dev/null 2>&1; then
        if ! echo "$SHELL_FILES" | xargs shellcheck -e SC2086; then
            print_error "Shell script linting failed"
            exit 1
        fi
        print_success "Shell script linting passed"
    else
        print_warning "shellcheck not found, skipping shell linting"
    fi
fi

# Check Docker files for best practices
DOCKER_FILES=$(echo "$STAGED_FILES" | grep 'Dockerfile' || true)

if [[ -n "$DOCKER_FILES" ]]; then
    echo "Checking Dockerfiles..."
    
    for dockerfile in $DOCKER_FILES; do
        # Check for common issues
        if grep -q "apt-get.*&&.*apt-get" "$dockerfile" 2>/dev/null; then
            if ! grep -q "rm -rf /var/lib/apt/lists" "$dockerfile"; then
                print_warning "${dockerfile}: Consider cleaning apt cache"
            fi
        fi
        
        # Check if using specific versions
        if grep -qE "FROM.*:latest" "$dockerfile" 2>/dev/null; then
            print_warning "${dockerfile}: Using :latest tag, consider pinning versions"
        fi
    done
    
    print_success "Dockerfile checks passed"
fi

# Success
print_success "Pre-commit checks passed"
exit 0
