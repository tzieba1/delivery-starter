#!/usr/bin/env bash
#
# pre-commit hook: Auto-sync TODO/FIXME tracking before commits
#
# This hook ensures TODO.md and FIXME.md stay synchronized with codebase.
# The todo-tracker binary must be available in PATH or tools/ directory.
#

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Find todo-tracker binary
find_tracker() {
    # Check common locations in order of preference
    local locations=(
        "./tools/todo-tracker-rust/target/release/todo-tracker"
        "./tools/todo-tracker-go/todo-tracker"
        "todo-tracker"  # In PATH
    )

    for loc in "${locations[@]}"; do
        if command -v "$loc" &> /dev/null || [[ -x "$loc" ]]; then
            echo "$loc"
            return 0
        fi
    done

    return 1
}

# Main
main() {
    echo -e "${BLUE}[pre-commit]${NC} Syncing TODO/FIXME tracking..."

    # Find tracker
    TRACKER=$(find_tracker) || {
        echo -e "${YELLOW}[pre-commit]${NC} todo-tracker not found, skipping sync"
        echo "  Build with: cd tools/todo-tracker-rust && cargo build --release"
        exit 0  # Don't block commit if tracker not available
    }

    # Run sync for both TODO and FIXME
    if ! "$TRACKER" --all 2>/dev/null; then
        echo -e "${RED}[pre-commit]${NC} todo-tracker sync failed"
        exit 1
    fi

    # Check if TODO.md or FIXME.md were modified
    if git diff --name-only TODO.md FIXME.md 2>/dev/null | grep -q .; then
        echo -e "${GREEN}[pre-commit]${NC} TODO/FIXME files updated, staging changes..."
        git add TODO.md FIXME.md .todo-tracker/ 2>/dev/null || true
    fi

    # Optional: Warn about URGENT items
    if [[ -f TODO.md ]] && grep -q '\[URGENT\]' TODO.md; then
        echo -e "${YELLOW}[pre-commit]${NC} Warning: URGENT TODOs present in codebase"
        grep -n '\[URGENT\]' TODO.md | head -5 | while read -r line; do
            echo "  $line"
        done
    fi

    echo -e "${GREEN}[pre-commit]${NC} TODO sync complete"
}

main "$@"
