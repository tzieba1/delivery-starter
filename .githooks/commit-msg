#!/usr/bin/env bash
#
# commit-msg hook: Validate commit message format
#
# Enforces conventional commit format and optionally links to TODOs.
# Format: <type>(<scope>): <description>
#
# Types: feat, fix, docs, style, refactor, test, chore, ci, perf, build
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits and fixup commits
if [[ "$COMMIT_MSG" =~ ^Merge ]] || [[ "$COMMIT_MSG" =~ ^fixup! ]] || [[ "$COMMIT_MSG" =~ ^squash! ]]; then
    exit 0
fi

# Conventional commit pattern
# type(optional-scope): description
PATTERN="^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\([a-zA-Z0-9_-]+\))?: .{1,}"

if ! echo "$COMMIT_MSG" | head -1 | grep -Eq "$PATTERN"; then
    echo -e "${RED}[commit-msg]${NC} Invalid commit message format"
    echo ""
    echo "Expected format: <type>(<scope>): <description>"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, test, chore, ci, perf, build, revert"
    echo ""
    echo "Examples:"
    echo "  feat(auth): add OAuth2 login flow"
    echo "  fix(api): handle null response from payment gateway"
    echo "  docs: update README with new CLI options"
    echo "  chore(deps): upgrade React to v18"
    echo ""
    echo "Your message: $(head -1 "$COMMIT_MSG_FILE")"
    exit 1
fi

# Check first line length (max 72 characters for git log)
FIRST_LINE=$(head -1 "$COMMIT_MSG_FILE")
if [[ ${#FIRST_LINE} -gt 72 ]]; then
    echo -e "${YELLOW}[commit-msg]${NC} Warning: First line exceeds 72 characters (${#FIRST_LINE})"
    echo "  Consider shortening for better git log display"
fi

echo -e "${GREEN}[commit-msg]${NC} Commit message format valid"
