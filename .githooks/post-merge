#!/usr/bin/env bash
#
# post-merge hook: Sync TODOs after pulling changes
#
# Runs after git pull/merge to ensure TODO tracking reflects merged changes.
# This catches TODOs added/removed by other developers.
#

set -euo pipefail

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

find_tracker() {
    local locations=(
        "./tools/todo-tracker-rust/target/release/todo-tracker"
        "./tools/todo-tracker-go/todo-tracker"
        "todo-tracker"
    )

    for loc in "${locations[@]}"; do
        if command -v "$loc" &> /dev/null || [[ -x "$loc" ]]; then
            echo "$loc"
            return 0
        fi
    done

    return 1
}

main() {
    echo -e "${BLUE}[post-merge]${NC} Checking TODO/FIXME changes from merge..."

    TRACKER=$(find_tracker) || {
        echo -e "${YELLOW}[post-merge]${NC} todo-tracker not found, skipping"
        exit 0
    }

    # Run in verbose mode to show what changed
    "$TRACKER" --all --verbose 2>/dev/null || true

    echo -e "${GREEN}[post-merge]${NC} TODO sync complete"
}

main "$@"
